    <button class="tab" role="tab" data-tab="events" aria-selected="false">Agenda<span class="n" id="n-events"></span></button>
    <button class="tab" role="tab" data-tab="notes" aria-selected="false">Note<span class="n" id="n-notes"></span></button>
    <button class="tab" role="tab" data-tab="contacts" aria-selected="false">Contatti<span class="n" id="n-contacts"></span></button>
    <button class="tab" role="tab" data-tab="expenses" aria-selected="false">Spese</button>
  </nav>

  <section class="talk" id="p-talk">
    <div class="talk-scroll" id="talkScroll">
      <div class="hero" id="hero">
        <div class="hero-dial">
          <svg class="dial" id="bigDial" viewBox="0 0 200 200" aria-hidden="true"></svg>
          <div class="dial-text"><div class="clock" id="clock">00:00</div><div class="day" id="dayText"></div></div>
        </div>
        <div class="hero-copy">
          <h2 id="greet">Buongiorno</h2>
