        <label>Modello <select id="modelSel"><option value="claude-sonnet-5-5">Sonnet 5.5, consigliato</option><option value="claude-haiku-4-5-20251001">Haiku 4.5, più rapido ed economico</option></select></label>
        <label style="flex:1 1 260px">Chiave API <input type="password" id="keyIn" placeholder="sk-ant-…" autocomplete="off" style="flex:1;min-width:0;width:100%"></label>
        <button class="small-btn" id="keySave" type="button">Salva chiave</button>
      </div>
      <div class="sa
